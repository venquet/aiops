#!/bin/sh
# Minimal Maven Wrapper launcher. The wrapper JAR and distribution URL are versioned with this project.
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Maven Wrapper JAR is missing: $WRAPPER_JAR" >&2
  exit 1
fi

if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_CMD="$JAVA_HOME/bin/java"
elif [ -x /opt/homebrew/opt/openjdk@21/bin/java ]; then
  JAVA_CMD="/opt/homebrew/opt/openjdk@21/bin/java"
else
  JAVA_CMD="java"
fi

exec "$JAVA_CMD" -Dmaven.multiModuleProjectDirectory="$BASE_DIR" -Dmaven.user.home="$BASE_DIR/.mvn-cache" \
  -Dmaven.repo.local="$BASE_DIR/.mvn-cache/repository" -classpath "$WRAPPER_JAR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
